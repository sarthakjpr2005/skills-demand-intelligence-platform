# Adzuna API Credentials
# Sign up for free at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
ADZUNA_COUNTRY=gb

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skills_platform
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Level 7: Monitoring & Quality SLAs
FRESHNESS_MAX_HOURS=24.0
QUARANTINE_MAX_FAIL_RATE=0.15
ZERO_SKILLS_MAX_RATE=0.35
MIN_BATCH_VOLUME=5

# Optional Webhook Notifications (Leave blank for console-only logging)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
